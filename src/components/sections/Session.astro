---
// THE TREATMENT-DAY RUNNER.
// Three of today's sessions are rendered: one live, two held by the engine.
// The gate chain, the checks, the blockers and the signature rules are all
// read from protocol.mjs — this screen renders the engine, it does not
// hard-code a happy path.
import { gates, evaluateGate, stoppingRules, monitoringTimepoints, vitalFields, reactionWatch, protocolMeta } from '../../data/protocol.mjs';
import { patients } from '../../data/cohort.mjs';
import { ROLES } from '../../data/roles.mjs';

const { role } = Astro.props;
const R = `/${role.id}`;

const running = patients.filter((p) => p.live);

function gateStatus(p, g) {
  const st = p.live.gateState[g.key] || {};
  const ev = evaluateGate(g, st);
  if (st.closedAt) return { cls: 'done', label: `Closed ${st.closedAt}`, ev, st };
  if (ev.status === 'blocked') return { cls: 'blocked', label: 'BLOCKED', ev, st };
  if (p.live.currentGate === g.key) return { cls: 'active', label: `${ev.satisfied}/${ev.required} verified`, ev, st };
  const order = gates.map((x) => x.key);
  if (order.indexOf(g.key) < order.indexOf(p.live.currentGate)) return { cls: 'done', label: 'Closed', ev, st };
  return { cls: 'locked', label: 'Locked', ev, st };
}

function thawRemaining(t) {
  if (!t) return null;
  const total = t.windowHours * 60;
  const left = total - t.elapsedMin;
  return { left, pct: Math.round((t.elapsedMin / total) * 100), h: Math.floor(left / 60), m: left % 60 };
}
---

<div class="stack">
  <div class="note live">
    <span class="lbl">How to read this screen</span>
    A treatment day is not a form to complete in any order. It is <b>six gates</b>, each with
    blocking checks, each owned by a named role, each writing a signed ledger entry when it closes.
    A gate that cannot close stops the day — and the reason is recorded against the clause it enforces.
    <b>Two of the three sessions below are stopped right now</b>, for two entirely different reasons.
  </div>

  <!-- Session switcher -->
  <div class="card">
    <div class="card-head"><h3>In clinic today</h3><span class="hint">{protocolMeta.id} v{protocolMeta.version}</span></div>
    <div class="card-body flush">
      <div class="sess-tabs">
        {running.map((p, i) => (
          <button class="sess-tab" data-sess={p.id} data-i={i}>
            <div style="display:flex;justify-content:space-between;gap:8px;align-items:flex-start">
              <div>
                <div class="mono tiny muted">{p.id} · {p.live.chair}</div>
                <div style="font-size:14px;font-weight:640;margin-top:2px">{p.name}</div>
                <div class="tiny muted" style="margin-top:2px">Session {p.live.session} of 6</div>
              </div>
              <span class={`chip ${p.status === 'live' ? 'live' : 'stop'}`}>{p.status === 'live' ? 'Running' : 'Held'}</span>
            </div>
          </button>
        ))}
      </div>
    </div>
  </div>

  {running.map((p, idx) => {
    const statuses = gates.map((g) => ({ g, ...gateStatus(p, g) }));
    const current = statuses.find((s) => s.cls === 'blocked') || statuses.find((s) => s.cls === 'active') || statuses[0];
    const thaw = thawRemaining(p.live.thaw);
    return (
      <div class="sess-panel" data-panel={p.id} style={idx === 0 ? '' : 'display:none'}>
        <div class="stack">
          <!-- Patient bar -->
          <div class="card">
            <div class="card-body" style="padding:14px 16px">
              <div class="row-between">
                <div>
                  <div class="row-between" style="justify-content:flex-start;gap:10px">
                    <h2 style="font-size:18px">{p.name}</h2>
                    <span class="chip ref">{p.id}</span>
                    <span class="chip">{p.age} · {p.sex}</span>
                    <span class={`chip ${p.consent.status === 'In force' || p.consent.status.startsWith('In force') ? 'ok' : 'stop'}`}>
                      Consent {p.consent.status}
                    </span>
                    {p.lar ? <span class="chip warn">LAR</span> : null}
                  </div>
                  <div class="tiny muted" style="margin-top:6px">
                    {p.diagnosis} · enrolled {p.enrolled} · caregiver {p.caregiver.name} ({p.caregiver.relationship})
                  </div>
                </div>
                <div style="text-align:right">
                  <div class="tiny muted">Session</div>
                  <div style="font-size:24px;font-weight:700;color:var(--navy-700);letter-spacing:-0.03em">{p.live.session}<span style="font-size:15px;color:var(--ink-4)"> / 6</span></div>
                  <div class="dots" style="justify-content:flex-end">
                    {p.sessions.map((s) => (
                      <span class={`dot ${s.status === 'Complete' ? 'done' : s.status === 'In progress' ? 'now' : s.status === 'Held' ? 'held' : s.status === 'Stopped' ? 'stopped' : ''}`}>{s.n}</span>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- The gate chain -->
          <div class="chain">
            {statuses.map((s) => (
              <button class={`chain-node ${s.cls}`} data-gate={`${p.id}-${s.g.key}`} data-sess={p.id} style="border:0;border-right:1px solid var(--line);text-align:left;font:inherit">
                <div class="gk">{s.g.key}</div>
                <div class="gn">{s.g.name.split(' — ')[0]}</div>
                <div class="gs">{s.label}</div>
                <div class="gref">{s.g.ref}</div>
              </button>
            ))}
          </div>

          {p.status === 'blocked' ? (
            <div class="note stop">
              <span class="lbl">Session held — gate {p.live.currentGate} cannot close</span>
              {p.blockReason}
              <div style="margin-top:8px"><span class="chip ref">{p.blockRef}</span> <span class="chip">Owner: {ROLES.find((r) => r.id === p.blockOwner)?.roleFull}</span></div>
            </div>
          ) : (
            <div class="note live">
              <span class="lbl">Session running · started {p.live.startedAt} · {p.live.chair}</span>
              Gates A and B closed and ledger-recorded. The day is currently at
              <b> Gate {p.live.currentGate} — {gates.find((g) => g.key === p.live.currentGate).name}</b>.
            </div>
          )}

          <div class="grid g-2-1">
            <!-- Gate detail panels -->
            <div>
              {statuses.map((s) => (
                <div class="gate-detail" data-gate-panel={`${p.id}-${s.g.key}`} style={s.g.key === current.g.key ? '' : 'display:none'}>
                  <div class="card">
                    <div class="card-head">
                      <div>
                        <h3>Gate {s.g.key} — {s.g.name}</h3>
                        <div class="tiny muted" style="margin-top:3px">
                          Owned by {ROLES.find((r) => r.id === s.g.owner)?.roleFull} · {s.g.ref} · writes Appendix {s.g.appendix}
                        </div>
                      </div>
                      <span class={`chip ${s.cls === 'done' ? 'ok' : s.cls === 'blocked' ? 'stop' : s.cls === 'active' ? 'live' : 'held'}`}>
                        {s.ev.satisfied}/{s.ev.required} blocking checks
                      </span>
                    </div>
                    <div class="card-body" style="padding:13px 16px;border-bottom:1px solid var(--line)">
                      <p class="tiny" style="margin:0;color:var(--ink-2);line-height:1.6">{s.g.summary}</p>
                    </div>
                    <div class="checks">
                      {s.g.checks.map((c) => {
                        const mark = (s.st.checks || {})[c.key];
                        const why = (s.st.blockers || {})[c.key];
                        const cls = mark === true ? 'yes' : why ? 'no' : 'open';
                        return (
                          <div class={`check ${cls}`}>
                            <span class="box">{mark === true ? '✓' : why ? '✕' : ''}</span>
                            <span>
                              <span class="cl">{c.label}</span>
                              <span class="cm">
                                <span class="chip ref">{c.ref}</span>
                                <span class={`src ${c.source}`}>{c.source === 'system' ? 'SYSTEM-ASSERTED' : 'OPERATOR'}</span>
                                {c.role ? <span class="muted">{ROLES.find((r) => r.id === c.role)?.role}</span> : <span class="muted">Any clinical role</span>}
                                <span class="muted">· records: {c.evidence}</span>
                              </span>
                              {why ? <span class="why"><b>Why this is blocking</b>{why}</span> : null}
                            </span>
                            <span class={`chip ${c.blocking ? 'stop' : 'held'}`} style={c.blocking ? 'background:var(--surface-sunk);color:var(--ink-3);border-color:var(--line)' : ''}>
                              {c.blocking ? 'Blocking' : 'Advisory'}
                            </span>
                          </div>
                        );
                      })}
                    </div>

                    {s.g.signatures && s.g.signatures.length ? (
                      <div class="card-body" style="border-top:1px solid var(--line)">
                        <div class="sec-title" style="margin-top:0">Signatures required to close</div>
                        <div class="sigs">
                          {s.g.signatures.map((sig) => {
                            const val = (s.st.signatures || {})[sig.key];
                            return (
                              <div class={`sig ${val ? 'signed' : ''}`}>
                                <div>
                                  <div class="sl">{sig.label}</div>
                                  <div class="sv">{val || '— not signed —'}</div>
                                  {sig.mustDifferFrom ? (
                                    <div class="sw">Must be a different authenticated user from the verifier. The platform compares identities, not initials on paper.</div>
                                  ) : sig.requires === 'canAuthorise' ? (
                                    <div class="sw">Requires a role with physician authorisation (Principal Investigator).</div>
                                  ) : null}
                                </div>
                                {!val && s.g.key === 'C' ? (
                                  <button class="btn sm primary sign-btn" data-sig={sig.key} data-requires={sig.requires} data-differs={sig.mustDifferFrom || ''}>
                                    Sign as {role.short}
                                  </button>
                                ) : val ? (
                                  <span class="chip ok dot">Recorded</span>
                                ) : (
                                  <span class="chip held">Pending</span>
                                )}
                              </div>
                            );
                          })}
                        </div>
                        <div id="sig-result" class="sig-result" style="display:none;margin-top:12px"></div>
                      </div>
                    ) : null}

                    {s.g.key === 'D' ? (
                      <div class="card-body" style="border-top:1px solid var(--line)">
                        <div class="sec-title" style="margin-top:0">Increment schedule — §5.2 D</div>
                        <div class="tbl-wrap">
                          <table class="tbl">
                            <thead><tr><th>Increment</th><th>Volume</th><th>Pause after</th><th>Recorded at</th><th>Reaction watch</th></tr></thead>
                            <tbody>
                              <tr><td class="n">1</td><td class="n">0.5 mL</td><td class="n">30–60 s</td><td class="mono muted">— pending —</td><td class="muted">Continuous</td></tr>
                              <tr><td class="n">2</td><td class="n">0.5 mL</td><td class="n">—</td><td class="mono muted">— pending —</td><td class="muted">Continuous</td></tr>
                            </tbody>
                          </table>
                        </div>
                        <div class="note" style="margin-top:12px">
                          <b>Not a bolus.</b> The engine timestamps each increment. If the two increments are recorded
                          less than 30 seconds apart, or the total push falls outside 10–15 minutes, the gate records a
                          deviation with a reason code rather than silently accepting it.
                        </div>
                      </div>
                    ) : null}

                    {s.g.key === 'F' ? (
                      <div class="card-body" style="border-top:1px solid var(--line)">
                        <div class="sec-title" style="margin-top:0">Observation grid — Appendix C</div>
                        <div class="tbl-wrap">
                          <table class="tbl">
                            <thead>
                              <tr><th>Timepoint</th>{vitalFields.map((f) => <th>{f}</th>)}<th>Init.</th></tr>
                            </thead>
                            <tbody>
                              {monitoringTimepoints.filter((t) => t.phase !== 'post').map((t) => {
                                const done = t.key === 'pre';
                                return (
                                  <tr class={done ? '' : ''}>
                                    <td class="t">{t.label}</td>
                                    {done ? (
                                      <>
                                        <td class="mono">{p.vitalsPre.bp}</td>
                                        <td class="mono">{p.vitalsPre.hr}</td>
                                        <td class="mono">{p.vitalsPre.rr}</td>
                                        <td class="mono">{p.vitalsPre.spo2}</td>
                                        <td class="mono">{p.vitalsPre.temp}</td>
                                        <td class="s">{p.vitalsPre.neuro}</td>
                                        <td class="mono">AB</td>
                                      </>
                                    ) : (
                                      <>
                                        {vitalFields.map(() => <td class="muted mono">—</td>)}
                                        <td class="muted mono">—</td>
                                      </>
                                    )}
                                  </tr>
                                );
                              })}
                            </tbody>
                          </table>
                        </div>
                        <div class="note warn" style="margin-top:12px">
                          <b>The timepoints are windows, not suggestions.</b> An observation recorded outside its window
                          creates a deviation with a reason code — that is exactly how DEV-0011 was detected, and the
                          roster change that followed came from the learning loop, not from someone noticing.
                        </div>
                      </div>
                    ) : null}
                  </div>
                </div>
              ))}
            </div>

            <!-- Right column: live context -->
            <div class="stack">
              {thaw ? (
                <div class="card">
                  <div class="card-head"><h3>Thaw stability window</h3><span class="chip live">Open</span></div>
                  <div class="card-body stack-sm">
                    <div class="row-between">
                      <span class="tiny muted">{p.live.thaw.product}</span>
                      <span class="mono tiny">{p.live.thaw.lot}</span>
                    </div>
                    <div class="clock">
                      <span class="big">{thaw.h}h {thaw.m}m</span>
                      <span class="of">remaining of {p.live.thaw.windowHours} h</span>
                    </div>
                    <div class="meter"><i class="live" style={`width:${thaw.pct}%`}></i></div>
                    <div class="tiny muted">
                      Thawed {p.live.thaw.thawedAt} · {p.live.thaw.method}. Gate E re-checks this window at the moment of
                      delivery, not at the start of the day — a session that overruns cannot quietly deliver
                      out-of-window product.
                    </div>
                  </div>
                </div>
              ) : null}

              <div class="card">
                <div class="card-head"><h3>Stopping rules — always live</h3><span class="hint">§6.3</span></div>
                <div class="card-body flush">
                  {stoppingRules.slice(0, 5).map((r) => (
                    <div class="check open" style="grid-template-columns:1fr auto">
                      <span>
                        <span class="cl">{r.complication}</span>
                        <span class="cm" style="display:block">{r.signs}</span>
                      </span>
                      <span class={`chip ${r.sae ? 'stop' : 'warn'}`}>{r.sae ? 'SAE · 24 h' : `Halts ${r.halts}`}</span>
                    </div>
                  ))}
                </div>
                <div class="card-body" style="border-top:1px solid var(--line)">
                  <button class="btn danger" style="width:100%" id="ae-btn">Record an adverse event</button>
                  <div id="ae-out" style="display:none;margin-top:12px"></div>
                </div>
              </div>

              <div class="card">
                <div class="card-head"><h3>Reaction watch</h3><span class="hint">Appendix C</span></div>
                <div class="card-body">
                  <div class="chip-row">
                    {reactionWatch.map((w) => <span class="chip">{w}</span>)}
                  </div>
                </div>
              </div>

              <div class="card">
                <div class="card-head"><h3>Patient safety context</h3></div>
                <div class="card-body">
                  <dl class="defs">
                    <div class="def"><dt>Prior session tolerated</dt><dd>{p.sessions[p.live.session - 2] ? (p.sessions[p.live.session - 2].tolerated ? 'Yes' : 'No — see events') : 'N/A (Session 1)'}</dd></div>
                    <div class="def"><dt>Capacity</dt><dd>{p.capacity}</dd></div>
                    <div class="def"><dt>Caregiver diary</dt><dd>{p.caregiver.diaryCompliance}</dd></div>
                    <div class="def"><dt>Latest hs-CRP</dt><dd>{(p.labs.find((l) => l.name === 'hs-CRP') || {}).value || '—'}</dd></div>
                    <div class="def"><dt>Pre-dose BP</dt><dd class="mono">{p.vitalsPre.bp}</dd></div>
                  </dl>
                  <a class="btn sm" style="margin-top:12px" href={`${R}/patient/${p.id}/`}>Open full record →</a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    );
  })}
</div>

<script is:inline define:vars={{ me: { id: role.id, short: role.short, name: role.name, role: role.role, canAuthorise: role.canAuthorise, canWitness: role.canWitness } }}>
  // Session switcher
  const tabs = document.querySelectorAll('.sess-tab');
  function showSess(id) {
    document.querySelectorAll('.sess-panel').forEach((el) => {
      el.style.display = el.dataset.panel === id ? '' : 'none';
    });
    tabs.forEach((t) => {
      t.style.borderBottomColor = t.dataset.sess === id ? 'var(--navy-700)' : 'transparent';
      t.style.background = t.dataset.sess === id ? 'var(--surface-2)' : 'var(--surface)';
    });
  }
  tabs.forEach((t) => t.addEventListener('click', () => showSess(t.dataset.sess)));
  if (tabs.length) showSess(tabs[0].dataset.sess);

  // Gate selection within a session
  document.querySelectorAll('.chain-node').forEach((n) => {
    n.addEventListener('click', () => {
      const key = n.dataset.gate;
      const sess = n.dataset.sess;
      document.querySelectorAll(`[data-gate-panel^="${sess}-"]`).forEach((p) => {
        p.style.display = p.dataset.gatePanel === key ? '' : 'none';
      });
      document.querySelectorAll(`.chain-node[data-sess="${sess}"]`).forEach((x) => x.style.outline = '');
      n.style.outline = '2px solid var(--navy-600)';
      n.style.outlineOffset = '-2px';
    });
  });

  // The two-person timeout rule, demonstrated.
  // N. Bello has already signed as verifier. Signing again as the same user is refused.
  const ALREADY_VERIFIER = 'nurse';
  document.querySelectorAll('.sign-btn').forEach((b) => {
    b.addEventListener('click', () => {
      const out = b.closest('.card-body').querySelector('.sig-result');
      const needs = b.dataset.requires;
      const differs = b.dataset.differs;
      let ok = true;
      let msg = '';

      if (needs === 'canAuthorise' && !me.canAuthorise) {
        ok = false;
        msg = '<b>Signature refused.</b> Physician authorisation under §5.2 C may only be recorded by a role holding authorisation authority. §3 Table 4 reserves that to the Principal Investigator, Dr. Sola. You are signed in as ' + me.short + ' (' + me.role + '), who may examine, review and witness but may not authorise an administration. Nothing has been written to the record; the refusal itself is logged to the audit trail.';
      } else if (differs && me.id === ALREADY_VERIFIER) {
        ok = false;
        msg = '<b>Signature refused — two-person verification.</b> You (' + me.short + ') are already recorded as the verifier at 09:34. §5.2 C requires the witness to be an independent second person. The platform compares authenticated identities, so one person cannot satisfy both halves of a timeout, however the paper form is filled in. A second signed-in clinical user must witness — Dr. Adesanya (Sub-Investigator) is on the unit and can.';
      } else if (!me.canWitness) {
        ok = false;
        msg = '<b>Signature refused.</b> Your role is not permitted to witness a pre-dose timeout.';
      } else {
        msg = '<b>Signature recorded.</b> ' + me.short + ' (' + me.role + ') witnessed the timeout at ' + new Date().toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' }) + ', as a different authenticated identity from the verifier. A ledger entry has been appended — who / did what / when / authority / to what / what next — and Gate C now waits only on physician authorisation from Dr. Sola.';
      }

      out.className = 'sig-result note ' + (ok ? 'ok' : 'stop');
      out.innerHTML = '<span class="lbl">' + (ok ? 'Recorded' : 'Refused by the engine') + '</span>' + msg;
      out.style.display = 'block';
      out.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
  });

  // Record an AE — shows the stopping-rule evaluation and the clock starting.
  const aeBtn = document.getElementById('ae-btn');
  if (aeBtn) {
    aeBtn.addEventListener('click', () => {
      const out = document.getElementById('ae-out');
      out.className = 'note stop';
      out.innerHTML =
        '<span class="lbl">Event capture opened — Appendix D</span>' +
        'Recording an event does four things at once, none of which depends on anyone remembering to do them:' +
        '<ul style="margin:8px 0 0;padding-left:18px;line-height:1.7">' +
        '<li>Opens <b>Appendix D</b> pre-filled with this patient, session, gate and timepoint.</li>' +
        '<li>Evaluates the event against the <b>seven stopping rules in §6.3</b>. If one matches, the session halts at the current gate — the operator does not get to continue.</li>' +
        '<li>Starts the <b>reporting clock</b> at recorded onset time: 24 hours for an SAE, 7 days for an AE. The clock runs from onset, not from when the form was opened, so a late entry cannot hide lateness.</li>' +
        '<li>Writes a ledger entry and notifies the Principal Investigator.</li>' +
        '</ul>';
      out.style.display = 'block';
    });
  }
</script>

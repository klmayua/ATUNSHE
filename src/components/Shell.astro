---
// Server-rendered app shell. Every page is generated per role, so the
// navigation a role cannot reach is not rendered and has no route at all —
// access control resolved at build time rather than hidden in the browser.
//
// Two navigations, one model: a persistent rail on desktop, and on a phone a
// bottom bar of the four destinations that role actually opens during a shift
// plus More, which lifts the same role-filtered tree in a sheet.
import { navFor, mobileNavFor, ICONS } from '../data/nav.mjs';
import '../styles/global.css';

const { role, section, title, sub, refs = [], pips = {} } = Astro.props;
const nav = navFor(role);
const bottom = mobileNavFor(role);
const sectionLabel = title;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#001428" />
    <meta name="robots" content="noindex" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <title>{sectionLabel} — Atunse Health Protocol Platform</title>
  </head>
  <body>
    <div class="shell">
      <!-- ===== Desktop rail ===== -->
      <aside class="rail" style={`--accent:${role.accent}`}>
        <div class="rail-head">
          <img src="/assets/atunse_gold_transparent.png" alt="" />
          <div>
            <b>Atunse Health</b>
            <span>Protocol Platform</span>
          </div>
        </div>

        <nav class="rail-nav">
          {nav.map((g) => (
            <div class="nav-group">
              <div class="nav-group-label">{g.group}</div>
              {g.items.map((it) => (
                <a class={`nav-item${it.key === section ? ' on' : ''}`} href={it.href}>
                  <span>{it.label}</span>
                  {pips[it.key] ? <span class={`pip ${pips[it.key].tone}`}>{pips[it.key].n}</span> : null}
                </a>
              ))}
            </div>
          ))}
        </nav>

        <div class="rail-foot">
          <div class="rail-env">atunse-lagos-01 · demo environment</div>
        </div>
      </aside>

      <div class="main">
        <!-- ===== Mobile top bar: logo centred ===== -->
        <header class="mbar">
          <button class="mbar-side" id="m-more-a" aria-label="Menu">
            <svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><path d={ICONS.more} /></svg>
          </button>
          <a class="mbar-logo" href={`/${role.id}/${role.home}/`} aria-label="Atunse Health">
            <img src="/assets/atunse_gold_transparent.png" alt="" />
            <span>Atunse Health</span>
          </a>
          <button class="mbar-side acct-av" id="m-acct" style={`background:${role.accent}`} aria-label="Account">{role.initials}</button>
        </header>

        <!-- ===== Desktop top bar ===== -->
        <header class="topbar">
          <div class="crumbs">
            <span>{role.role}</span>
            <span class="sep">/</span>
            <b>{sectionLabel}</b>
          </div>
          <div class="topbar-right">
            <span class="env-chip hide-sm">Wed 26 Aug 2026 · WAT</span>
            {!role.isPatient && !role.isCaregiver ? (
              <span class="env-chip hide-sm">ATN-DEM-ADDSB-2026-001 v1.0</span>
            ) : null}

            <div class="acct">
              <button class="acct-btn" id="acct-btn" aria-haspopup="true" aria-expanded="false">
                <span class="acct-txt">
                  <span class="acct-nm">{role.short}</span>
                  <span class="acct-rl">{role.role}</span>
                </span>
                <span class="acct-av" style={`background:${role.accent}`}>{role.initials}</span>
              </button>
              <div class="acct-menu" id="acct-menu" hidden>
                <div class="acct-head">
                  <span class="acct-av lg" style={`background:${role.accent}`}>{role.initials}</span>
                  <div style="min-width:0">
                    <div class="acct-nm2">{role.name}</div>
                    <div class="acct-rl2">{role.roleFull}</div>
                  </div>
                </div>
                <div class="acct-meta">
                  <div><span>Signed in as</span><b class="mono">{role.username}</b></div>
                  <div><span>Tenant</span><b class="mono">atunse-lagos-01</b></div>
                  <div><span>Session</span><b class="mono">Expires 18:00 WAT</b></div>
                </div>
                <a class="acct-item" href="/">Sign out</a>
              </div>
            </div>
          </div>
        </header>

        <main class="page">
          <div class="page-head">
            <h1>{title}</h1>
            {sub ? <p class="sub" set:html={sub} /> : null}
            {refs.length ? (
              <div class="refline">
                {refs.map((r) => <span class="chip ref">{r}</span>)}
              </div>
            ) : null}
          </div>
          <slot />
        </main>
      </div>
    </div>

    <!-- ===== Mobile bottom navigation ===== -->
    <nav class="bnav" aria-label="Primary">
      {bottom.map((it) => (
        <a class={`bnav-item${it.key === section ? ' on' : ''}`} href={it.href}>
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d={it.icon} /></svg>
          <span>{it.label}</span>
          {pips[it.key] ? <i class={`bnav-pip ${pips[it.key].tone}`}></i> : null}
        </a>
      ))}
      <button class="bnav-item" id="m-more-b" aria-label="More">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d={ICONS.more} /></svg>
        <span>More</span>
      </button>
    </nav>

    <!-- ===== Mobile sheet: full role nav + account ===== -->
    <div class="sheet-scrim" id="m-scrim" hidden></div>
    <div class="sheet" id="m-sheet" hidden role="dialog" aria-modal="true" aria-label="Menu">
      <div class="sheet-grip"></div>
      <div class="sheet-who">
        <span class="acct-av lg" style={`background:${role.accent}`}>{role.initials}</span>
        <div style="min-width:0">
          <div class="acct-nm2">{role.name}</div>
          <div class="acct-rl2">{role.roleFull}</div>
        </div>
      </div>
      <div class="sheet-scroll">
        {nav.map((g) => (
          <div class="nav-group">
            <div class="sheet-group-label">{g.group}</div>
            {g.items.map((it) => (
              <a class={`sheet-item${it.key === section ? ' on' : ''}`} href={it.href}>
                <span>{it.label}</span>
                {pips[it.key] ? <span class={`pip ${pips[it.key].tone}`}>{pips[it.key].n}</span> : null}
              </a>
            ))}
          </div>
        ))}
        <div class="sheet-meta">
          <div><span>Signed in as</span><b class="mono">{role.username}</b></div>
          <div><span>Tenant</span><b class="mono">atunse-lagos-01</b></div>
        </div>
        <a class="sheet-out" href="/">Sign out</a>
      </div>
    </div>

    <script is:inline>
      (function () {
        // Desktop account menu
        var btn = document.getElementById('acct-btn');
        var menu = document.getElementById('acct-menu');
        if (btn && menu) {
          function closeMenu() { menu.hidden = true; btn.setAttribute('aria-expanded', 'false'); }
          btn.addEventListener('click', function (e) {
            e.stopPropagation();
            var open = menu.hidden;
            menu.hidden = !open;
            btn.setAttribute('aria-expanded', String(open));
          });
          document.addEventListener('click', function (e) {
            if (!menu.hidden && !menu.contains(e.target)) closeMenu();
          });
        }

        // Card-mode table labels.
        // The stacked layout is CSS, so it is right before this runs; this
        // only copies each column's <th> onto its cells so a field keeps its
        // name once the header row is visually hidden. Matrix tables, where
        // the grid itself is the meaning, are skipped.
        Array.prototype.forEach.call(document.querySelectorAll('table.tbl'), function (t) {
          if (t.hasAttribute('data-matrix')) return;
          var heads = t.querySelectorAll('thead th');
          if (!heads.length) return;
          var labels = Array.prototype.map.call(heads, function (h) {
            return (h.textContent || '').trim();
          });
          Array.prototype.forEach.call(t.querySelectorAll('tbody tr'), function (row) {
            Array.prototype.forEach.call(row.children, function (cell, i) {
              if (labels[i] && !cell.hasAttribute('data-label')) {
                cell.setAttribute('data-label', labels[i]);
              }
            });
          });
        });

        // Mobile sheet
        var sheet = document.getElementById('m-sheet');
        var scrim = document.getElementById('m-scrim');
        function openSheet() {
          sheet.hidden = false; scrim.hidden = false;
          requestAnimationFrame(function () { sheet.classList.add('up'); scrim.classList.add('in'); });
          document.body.style.overflow = 'hidden';
        }
        function closeSheet() {
          sheet.classList.remove('up'); scrim.classList.remove('in');
          document.body.style.overflow = '';
          setTimeout(function () { sheet.hidden = true; scrim.hidden = true; }, 220);
        }
        ['m-more-a', 'm-more-b', 'm-acct'].forEach(function (id) {
          var el = document.getElementById(id);
          if (el) el.addEventListener('click', openSheet);
        });
        if (scrim) scrim.addEventListener('click', closeSheet);
        document.addEventListener('keydown', function (e) {
          if (e.key !== 'Escape') return;
          if (menu && !menu.hidden) { menu.hidden = true; btn.setAttribute('aria-expanded', 'false'); }
          if (sheet && !sheet.hidden) closeSheet();
        });
      })();
    </script>
  </body>
</html>

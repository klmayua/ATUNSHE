---
// Server-rendered app shell. Every page is generated per role, so the
// navigation a role cannot reach is not rendered and has no route at all —
// access control resolved at build time rather than hidden in the browser.
import { navFor } from '../data/nav.mjs';
import '../styles/global.css';

const { role, section, title, sub, refs = [], pips = {} } = Astro.props;
const nav = navFor(role);
const sectionLabel = title;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <title>{sectionLabel} — Atunse Health Protocol Platform</title>
  </head>
  <body>
    <div class="shell">
      <aside class="rail" style={`--accent:${role.accent}`}>
        <div class="rail-head">
          <img src="/assets/atunse_gold_transparent.png" alt="" />
          <div>
            <b>Atunse Health</b>
            <span>Protocol Platform</span>
          </div>
        </div>

        <nav class="rail-nav">
          {nav.map((g) => (
            <div class="nav-group">
              <div class="nav-group-label">{g.group}</div>
              {g.items.map((it) => (
                <a class={`nav-item${it.key === section ? ' on' : ''}`} href={it.href}>
                  <span>{it.label}</span>
                  {pips[it.key] ? <span class={`pip ${pips[it.key].tone}`}>{pips[it.key].n}</span> : null}
                </a>
              ))}
            </div>
          ))}
        </nav>

        <div class="rail-foot">
          <div class="rail-env">atunse-lagos-01 · demo environment</div>
        </div>
      </aside>

      <div class="main">
        <header class="topbar">
          <div class="crumbs">
            <span>{role.role}</span>
            <span class="sep">/</span>
            <b>{sectionLabel}</b>
          </div>
          <div class="topbar-right">
            <span class="env-chip hide-sm">Wed 26 Aug 2026 · WAT</span>
            {!role.isPatient && !role.isCaregiver ? (
              <span class="env-chip hide-sm">ATN-DEM-ADDSB-2026-001 v1.0</span>
            ) : null}

            <div class="acct">
              <button class="acct-btn" id="acct-btn" aria-haspopup="true" aria-expanded="false">
                <span class="acct-txt">
                  <span class="acct-nm">{role.short}</span>
                  <span class="acct-rl">{role.role}</span>
                </span>
                <span class="acct-av" style={`background:${role.accent}`}>{role.initials}</span>
              </button>
              <div class="acct-menu" id="acct-menu" hidden>
                <div class="acct-head">
                  <span class="acct-av lg" style={`background:${role.accent}`}>{role.initials}</span>
                  <div style="min-width:0">
                    <div class="acct-nm2">{role.name}</div>
                    <div class="acct-rl2">{role.roleFull}</div>
                  </div>
                </div>
                <div class="acct-meta">
                  <div><span>Signed in as</span><b class="mono">{role.username}</b></div>
                  <div><span>Tenant</span><b class="mono">atunse-lagos-01</b></div>
                  <div><span>Session</span><b class="mono">Expires 18:00 WAT</b></div>
                </div>
                <a class="acct-item" href="/">Sign out</a>
              </div>
            </div>
          </div>
        </header>

        <main class="page">
          <div class="page-head">
            <h1>{title}</h1>
            {sub ? <p class="sub" set:html={sub} /> : null}
            {refs.length ? (
              <div class="refline">
                {refs.map((r) => <span class="chip ref">{r}</span>)}
              </div>
            ) : null}
          </div>
          <slot />
        </main>
      </div>
    </div>

    <script is:inline>
      (function () {
        var btn = document.getElementById('acct-btn');
        var menu = document.getElementById('acct-menu');
        if (!btn || !menu) return;
        function close() { menu.hidden = true; btn.setAttribute('aria-expanded', 'false'); }
        btn.addEventListener('click', function (e) {
          e.stopPropagation();
          var open = menu.hidden;
          menu.hidden = !open;
          btn.setAttribute('aria-expanded', String(open));
        });
        document.addEventListener('click', function (e) {
          if (!menu.hidden && !menu.contains(e.target)) close();
        });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });
      })();
    </script>
  </body>
</html>

---
// Server-rendered app shell. Every page is generated per role, so the
// navigation a role cannot reach is not rendered and has no route at all —
// access control resolved at build time rather than hidden in the browser.
import { navFor } from '../data/nav.mjs';
import '../styles/global.css';

const { role, section, title, sub, refs = [], pips = {} } = Astro.props;
const nav = navFor(role);
const sectionLabel = title;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <title>{sectionLabel} — Atunse Health Protocol Platform</title>
  </head>
  <body>
    <div class="shell">
      <aside class="rail" style={`--accent:${role.accent}`}>
        <div class="rail-head">
          <img src="/assets/atunse_gold_transparent.png" alt="" />
          <div>
            <b>Atunse Health</b>
            <span>Protocol Platform</span>
          </div>
        </div>

        <div class="rail-who">
          <div class="av">{role.initials}</div>
          <div style="min-width:0">
            <div class="nm">{role.short}</div>
            <div class="rl">{role.role}</div>
          </div>
        </div>

        <nav class="rail-nav">
          {nav.map((g) => (
            <div class="nav-group">
              <div class="nav-group-label">{g.group}</div>
              {g.items.map((it) => (
                <a class={`nav-item${it.key === section ? ' on' : ''}`} href={it.href}>
                  <span>{it.label}</span>
                  {pips[it.key] ? <span class={`pip ${pips[it.key].tone}`}>{pips[it.key].n}</span> : null}
                </a>
              ))}
            </div>
          ))}
        </nav>

        <div class="rail-foot">
          <a href="/">Switch role</a>
          <div class="rail-env">atunse-lagos-01 · demo</div>
        </div>
      </aside>

      <div class="main">
        <header class="topbar">
          <div class="crumbs">
            <span>{role.role}</span>
            <span class="sep">/</span>
            <b>{sectionLabel}</b>
          </div>
          <div class="topbar-right">
            <span class="env-chip">Wed 26 Aug 2026 · WAT</span>
            <span class="env-chip">ATN-DEM-ADDSB-2026-001 v1.0</span>
          </div>
        </header>

        <main class="page">
          <div class="page-head">
            <h1>{title}</h1>
            {sub ? <p class="sub" set:html={sub} /> : null}
            {refs.length ? (
              <div class="refline">
                {refs.map((r) => <span class="chip ref">{r}</span>)}
              </div>
            ) : null}
          </div>
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>

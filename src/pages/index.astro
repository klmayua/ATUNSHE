---
import { ROLES } from '../data/roles.mjs';
import '../styles/global.css';

const staff = ROLES.filter((r) => !r.isPatient && !r.isCaregiver);
const people = ROLES.filter((r) => r.isPatient || r.isCaregiver);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <title>Atunse Health — Sign in</title>
  </head>
  <body class="signin-body">
    <main class="signin">
      <div class="signin-card">
        <img class="signin-logo" src="/assets/atunse_gold_transparent.png" alt="Atunse Health" />
        <h1>Atunse Health</h1>
        <p class="signin-tag">Protocol Platform</p>

        <div id="err" class="gate-err" style="display:none"></div>

        <form class="signin-form" id="f">
          <div>
            <label for="u">Username</label>
            <input id="u" type="text" placeholder="e.g. f.sola" autocomplete="off" />
          </div>
          <div>
            <label for="p">Password</label>
            <input id="p" type="password" placeholder="••••••" autocomplete="off" />
          </div>
          <button type="submit">Sign in</button>
        </form>

        <div class="gate-or">or continue as</div>

        <div class="signin-group-label">Clinical &amp; operations</div>
        <div class="signin-grid">
          {staff.map((r) => (
            <button type="button" class="signin-role" data-role={r.id} style={`--accent:${r.accent}`}>
              <span class="av">{r.initials}</span>
              <span class="tx">
                <span class="nm">{r.name}</span>
                <span class="rl">{r.role}</span>
              </span>
            </button>
          ))}
        </div>

        <div class="signin-group-label">Patient &amp; family</div>
        <div class="signin-grid">
          {people.map((r) => (
            <button type="button" class="signin-role" data-role={r.id} style={`--accent:${r.accent}`}>
              <span class="av">{r.initials}</span>
              <span class="tx">
                <span class="nm">{r.name}</span>
                <span class="rl">{r.role}</span>
              </span>
            </button>
          ))}
        </div>

        <p class="signin-note" id="hint">
          Choose an account above to fill in its credentials, then sign in.
          Password is <span class="mono">demo</span> for every account. All patient data is fabricated.
        </p>
      </div>

      <p class="signin-foot">
        Atunse Health EMR · Protocol <span class="mono">ATN-DEM-ADDSB-2026-001</span> v1.0<br />
        Prepared by Farawa for Atunse Health leadership · Confidential
      </p>
    </main>

    <script is:inline define:vars={{ roles: ROLES.map((r) => ({ id: r.id, u: r.username, p: r.password, home: r.home, name: r.name })) }}>
      const f = document.getElementById('f');
      const e = document.getElementById('err');
      const uEl = document.getElementById('u');
      const pEl = document.getElementById('p');
      const hint = document.getElementById('hint');

      // Choosing an account fills the credentials. It does NOT sign in —
      // the user still clicks Sign in, so the login step is actually seen.
      document.querySelectorAll('.signin-role').forEach((btn) => {
        btn.addEventListener('click', () => {
          const r = roles.find((x) => x.id === btn.dataset.role);
          if (!r) return;
          e.style.display = 'none';
          uEl.value = r.u;
          pEl.value = r.p;
          document.querySelectorAll('.signin-role').forEach((b) => b.classList.remove('picked'));
          btn.classList.add('picked');
          hint.innerHTML =
            'Credentials filled for <b>' + r.name + '</b>. Click <b>Sign in</b> to continue.';
          uEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
        });
      });

      f.addEventListener('submit', (ev) => {
        ev.preventDefault();
        e.style.display = 'none';
        const u = uEl.value.trim().toLowerCase();
        const p = pEl.value;
        const r = roles.find((x) => x.u === u || x.id === u);
        if (!r) {
          e.textContent = 'No account matches that username.';
          e.style.display = 'block';
          return;
        }
        if (r.p !== p) {
          e.textContent = 'Incorrect password. For this demonstration it is “demo”.';
          e.style.display = 'block';
          return;
        }
        location.assign('/' + r.id + '/' + r.home + '/');
      });
    </script>
  </body>
</html>

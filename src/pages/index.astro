---
import { PERSONAS } from '../data/personas.mjs';
import '../styles/global.css';

const year = new Date().getFullYear();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <title>Atunse Health — Demo Login</title>
  </head>
  <body>
    <main class="login-main">
      <div class="login-card">
        <img src="/assets/atunse_gold_transparent.png" alt="Atunse Health" class="logo-lg" />
        <h2>Protocol-driven care.<br />One trusted record.</h2>
        <p class="sub">Sign in to the clinical platform, or explore it as a persona.</p>

        <div id="err" class="err" style="display:none"></div>

        <form id="login-form" autocomplete="off">
          <div class="field">
            <label for="username">Username</label>
            <input id="username" name="username" type="text" placeholder="e.g. amina.okafor" />
          </div>
          <div class="field">
            <label for="password">Password</label>
            <input id="password" name="password" type="password" placeholder="••••••••" />
          </div>
          <button class="btn-primary" type="submit">Sign in</button>
        </form>

        <div class="divider">Or explore as a persona</div>

        <div class="persona-grid" id="persona-grid">
          {PERSONAS.map((p) => (
            <button class="persona" type="button" data-id={p.id}>
              <span class="av">{p.initials}</span>
              <span>
                <span class="nm">{p.name}</span><br />
                <span class="rl">{p.role}</span>
                <span class="hint">tap to enter →</span>
              </span>
            </button>
          ))}
        </div>
      </div>
    </main>

    <script is:inline define:vars={{ personas: PERSONAS }}>
      const PERSONAS = personas;
      const KEY = 'atunse_demo_session';
      const form = document.getElementById('login-form');
      const errEl = document.getElementById('err');
      const userEl = document.getElementById('username');
      const passEl = document.getElementById('password');

      function fail(msg) {
        errEl.textContent = msg;
        errEl.style.display = 'block';
      }
      function go(persona) {
        if (!persona) return fail('Unknown persona.');
        try {
          localStorage.setItem(KEY, JSON.stringify({
            id: persona.id, name: persona.name, role: persona.role,
            username: persona.username, initials: persona.initials, accent: persona.accent, at: Date.now(),
          }));
        } catch (e) {}
        // Carry the persona in the URL so downstream screen pages work even if
        // localStorage is unavailable/cleared (no more dead-end login bounce).
        window.location.assign('/app/dashboard/' + persona.id + '/?p=' + persona.id);
      }
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        errEl.style.display = 'none';
        const u = userEl.value.trim();
        const pw = passEl.value;
        const p = PERSONAS.find((x) => x.username === u);
        if (!p) return fail('No demo account matches that username.');
        if (p.password !== pw) return fail('Incorrect demo password. (Hint: tap a persona to auto-fill.)');
        go(p);
      });
      document.querySelectorAll('.persona').forEach((btn) => {
        btn.addEventListener('click', () => {
          const p = PERSONAS.find((x) => x.id === btn.dataset.id);
          if (p) { userEl.value = p.username; passEl.value = p.password; go(p); }
        });
      });
    </script>
  </body>
</html>

---
import { PERSONAS } from '../../../data/personas.mjs';
import { DASHBOARDS } from '../../../data/dashboards.mjs';
import { screens } from '../../../data/screens.mjs';
import '../../../styles/global.css';

export function getStaticPaths() {
  return PERSONAS.map((p) => ({ params: { persona: p.id } }));
}

const { persona } = Astro.params;
const p = PERSONAS.find((x) => x.id === persona);
const d = DASHBOARDS[persona];

function escape(s) {
  return String(s).replace(/[&<>\x22\x27]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
}

// RBAC-filtered nav: only groups this persona is allowed to view.
const ORDER = [
  ['Overview', 'Dashboards'],
  ['Patients', 'Patient'],
  ['Appointments', 'Scheduling'],
  ['Clinical', 'Clinical'],
  ['Protocols', 'Protocols'],
  ['Trust & Governance', 'Compliance & Ledgers'],
  ['Billing', 'Billing & Finance'],
  ['Ogami', 'AI Assistant'],
  ['Reports', 'Operations & Intelligence'],
  ['Administration', 'Administration'],
  ['Mobile', 'Mobile'],
];
function canView(group) {
  return !(p.deny || []).includes(group) && p.allow.includes(group);
}
function firstScreenHref(group) {
  const s = screens.find((x) => !x.asset && x.group === group);
  return s ? `/app/${s.id}/` : null;
}
const navHtml = ORDER
  .filter(([, group]) => canView(group))
  .map(([label, group]) => {
    const href = group === 'Dashboards' ? `/app/dashboard/${persona}/` : firstScreenHref(group) || `/app/dashboard/${persona}/`;
    const active = group === 'Dashboards';
    return `<a class="nav-link${active ? ' active' : ''}" href="${href}">${label}</a>`;
  })
  .join('');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <title>Atunse Health — {p.role}</title>
  </head>
  <body>
    <div class="app-shell">
      <aside class="sidenav">
        <div class="nav-head">
          <img src="/assets/atunse_gold_transparent.png" alt="Atunse Health" class="logo" />
          <span class="brand">Atunse Health</span>
        </div>
        <div class="who">{p.name} · <b>{p.role}</b></div>
        <nav class="nav" set:html={navHtml}></nav>
        <div class="nav-foot"><a class="btn-logout" href="/" onclick="localStorage.removeItem('atunse_demo_session');">Log out</a></div>
      </aside>

      <section class="stage">
        <header class="stage-bar"><span class="crumb">Dashboard</span></header>
        <div class="dash">
          <h1 class="dash-greet">{escape(d.greeting)}</h1>
          <p class="dash-sub">{escape(d.sub)}</p>

          <div class="kpis">
            {d.kpis.map((k) => (
              <div class="kpi">
                <div class="n">{escape(k.n)}</div>
                <div class="l">{escape(k.l)}</div>
                {k.delta ? <div class={`delta ${k.dir || 'flat'}`}>{escape(k.delta)}</div> : null}
              </div>
            ))}
          </div>

          <div class="dash-grid">
            {d.sections.map((sec) => (
              <div class={`card${sec.alert ? ' alert' : ''}`}>
                <h3>{escape(sec.title)}</h3>
                {sec.chart ? (
                  sec.chart.type === 'bars'
                    ? <div class="chart bars">{sec.chart.vals.split(',').map((v) => <span class="bar" style={`--h:${v}%`}></span>)}</div>
                    : <div class="chart line">{sec.chart.vals.split(',').map((v) => <span class="dot" style={`--h:${v}%`}></span>)}</div>
                ) : null}
                {sec.items.map((it) => (
                  <div class="row">
                    <div>
                      <div class="t">{escape(it.t)}{it.tag ? ` <span class="tag">${escape(it.tag)}</span>` : ''}</div>
                      <div class="s">{escape(it.s)}</div>
                    </div>
                    {it.time ? <div class="time">{escape(it.time)}</div> : null}
                  </div>
                ))}
              </div>
            ))}

            {d.protocols && d.protocols.length ? (
              <div class="card">
                <h3>Protocols</h3>
                {d.protocols.map((pr) => {
                  const over = /overdue|book/i.test(pr.status);
                  return (
                    <div class="protocol">
                      <div>
                        <div class="pn">{escape(pr.name)}</div>
                        <div class="ps">{escape(pr.step)}{pr.patient ? ` · ${escape(pr.patient)}` : ''}</div>
                      </div>
                      <div class={`pst ${over ? 'over' : 'ok'}`}>{escape(pr.status)}</div>
                    </div>
                  );
                })}
              </div>
            ) : null}
          </div>

          <div class="actions">
            {d.actions.map((a) => (
              <button class={/book|message|view|quick|sync|add|review|staff/i.test(a) ? 'btn btn-ghost' : 'btn btn-primary'} data-action={a}>{escape(a)}</button>
            ))}
          </div>
        </div>
      </section>
    </div>
    <script is:inline define:vars={{ screens: screens, persona: persona }}>
      const SCREENS = screens;
      const PID = persona;
      function hrefForGroup(group) {
        const s = SCREENS.find((x) => !x.asset && x.group === group);
        return s ? '/app/' + s.id + '/' : '/app/dashboard/' + PID + '/';
      }
      const MAP = {
        'Start Encounter': 'Clinical',
        'Book Appointment': 'Scheduling',
        'Message care team': 'Patient',
        'View records': 'Patient',
        'Add staff': 'Administration',
        'Review approvals': 'Administration',
        'Billing ops': 'Billing & Finance',
        'Review protocols': 'Protocols',
        'Staff oversight': 'Administration',
        'Quick lookup': 'Mobile',
        'Sync now': 'Mobile',
      };
      document.querySelectorAll('button[data-action]').forEach((b) => {
        b.addEventListener('click', () => {
          const g = MAP[b.dataset.action];
          if (g) window.location.assign(hrefForGroup(g));
          else alert(b.dataset.action + ' — demo action');
        });
      });
    </script>
  </body>
</html>

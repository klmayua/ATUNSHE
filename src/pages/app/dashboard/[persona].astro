---
import { PERSONAS } from '../../../data/personas.mjs';
import { DASHBOARDS } from '../../../data/dashboards.mjs';
import { screens } from '../../../data/screens.mjs';
import * as D from '../../../data/atunse.mjs';
import { navFor, hrefForGroup } from '../../../data/nav.mjs';
import '../../../styles/global.css';

export function getStaticPaths() {
  return PERSONAS.map((p) => ({ params: { persona: p.id } }));
}

const { persona } = Astro.params;
const p = PERSONAS.find((x) => x.id === persona);
const d = DASHBOARDS[persona];

function escape(s) {
  return String(s).replace(/[&<>\x22\x27]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
}

const navTree = navFor(p); // RBAC-filtered, real screens (shared with [screen].astro)

// ---- REAL clinician workbench, built from atunse.mjs ----
const todayAppts = D.appointments.filter((a) => a.patient && a.status && a.status !== 'Done');
// Overdue = any protocol session (ADDSB course) still 'Overdue'.
const overdueSteps = D.protocols.flatMap((pr) =>
  (pr.course || []).filter((s) => s.status === 'Overdue').map((s) => ({ protocol: pr.name, step: `Week ${s.wk} session`, patient: pr.indication }))
);
const vitalsGaps = D.patients
  .filter((pt) => pt.vitals && /gap|5d|old/i.test(pt.timeline?.[0]?.text || ''))
  .map((pt) => pt.name);
const carePatients = D.patients.map((pt) => ({
  name: pt.name,
  id: pt.id,
  dx: (pt.conditions || []).map((c) => c.name).join(', '),
  // Only Amina has dedicated Profile/Timeline screens in the demo registry;
  // all patient cards open the Patient Directory (the real longitudinal record entry).
  profileHref: `/app/fe22f6b0e70e44e69c62b4c69019163d/`,
  timelineHref: `/app/fe22f6b0e70e44e69c62b4c69019163d/`,
}));
const activeProtocols = D.protocols.map((pr) => ({
  name: pr.name,
  code: pr.code,
  steps: (pr.course && pr.course.length) || (pr.steps && pr.steps.length) || 0,
  overdue: (pr.course || []).filter((s) => s.status === 'Overdue').length,
  href: hrefForGroup(p, 'Protocols'),
}));

// Action button -> concrete href (not "first of group")
const P = '?p=' + persona;
const ACTION_HREF = {
  'Start Encounter': hrefForGroup(p, 'Clinical') + P,
  'Book Appointment': hrefForGroup(p, 'Scheduling') + P,
  'Review protocols': hrefForGroup(p, 'Protocols') + P,
  'Message care team': `/app/4a98aee24a83424db3010d3076a5a42c/` + P,
  'View records': hrefForGroup(p, 'Patient') + P,
  'Add staff': hrefForGroup(p, 'Administration') + P,
  'Review approvals': hrefForGroup(p, 'Administration') + P,
  'Billing ops': hrefForGroup(p, 'Billing & Finance') + P,
  'Staff oversight': hrefForGroup(p, 'Administration') + P,
  'Quick lookup': hrefForGroup(p, 'Mobile') + P,
  'Sync now': hrefForGroup(p, 'Mobile') + P,
  'View reports': hrefForGroup(p, 'Operations & Intelligence'),
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <title>Atunse Health — {p.role}</title>
  </head>
  <body>
    <div class="app-shell">
      <aside class="sidenav">
        <div class="nav-head">
          <img src="/assets/atunse_gold_transparent.png" alt="Atunse Health" class="logo" />
          <span class="brand">Atunse Health</span>
        </div>
        <div class="who">{p.name} · <b>{p.role}</b></div>
        <nav class="nav">
          {navTree.map((g) => (
            <div class="nav-group">
              <div class="nav-group-label">{g.label}</div>
              {g.items.map((it) => (
                <a class={`nav-link${it.id === '__dash' ? ' active' : ''}`} href={it.href + '?p=' + persona}>{it.title}</a>
              ))}
            </div>
          ))}
        </nav>
        <div class="nav-foot"><a class="btn-logout" href={`/?p=${persona}`} onclick="try{localStorage.removeItem('atunse_demo_session');}catch(e){}">Log out</a></div>
      </aside>

      <section class="stage">
        <header class="stage-bar"><span class="crumb">Dashboard</span>
          <div class="user-chip">
            <div class="un"><div class="nm">{p.name}</div><div class="rl">{p.role}</div></div>
            <div class="ava">{p.initials}</div>
          </div>
        </header>
        <div class="dash">
          <h1 class="dash-greet">{escape(d.greeting)}</h1>
          <p class="dash-sub">{escape(d.sub)}</p>

          {persona === 'clinician' || persona === 'attending' ? (
            <div class="dash-grid">
              <!-- Today's schedule -->
              <div class="card">
                <h3>Today's schedule</h3>
                {todayAppts.length ? (
                  todayAppts.map((a) => (
                    <div class="row">
                      <div>
                        <div class="t">{escape(a.patient)}</div>
                        <div class="s">{escape(a.reason)} · {escape(a.provider)}</div>
                      </div>
                      <div class="time">{escape(a.time)}</div>
                    </div>
                  ))
                ) : (
                  <div class="row"><div class="s">No further appointments today.</div></div>
                )}
              </div>

              <!-- My alerts / overdue protocol steps -->
              <div class="card alert">
                <h3>My alerts</h3>
                {overdueSteps.map((o) => (
                  <div class="row">
                    <div>
                      <div class="t">Overdue — {escape(o.protocol)}</div>
                      <div class="s">{escape(o.step)} · {escape(o.patient)}</div>
                    </div>
                    <div class="tag over">Urgent</div>
                  </div>
                ))}
                {vitalsGaps.length ? (
                  <div class="row">
                    <div><div class="t">Vitals gap</div><div class="s">{escape(vitalsGaps.join(', '))} · last captured 5d ago</div></div>
                    <div class="tag">Watch</div>
                  </div>
                ) : null}
              </div>

              <!-- Patients in my care -->
              <div class="card">
                <h3>Patients in my care</h3>
                {carePatients.map((pt) => (
                  <div class="row">
                    <div>
                      <div class="t">{escape(pt.name)} <span class="muted">{escape(pt.id)}</span></div>
                      <div class="s">{escape(pt.dx)}</div>
                    </div>
                    <div class="row-actions">
                      <a class="btn btn-ghost btn-sm" href={pt.profileHref}>Open record</a>
                      <a class="btn btn-ghost btn-sm" href={pt.timelineHref}>Directory</a>
                    </div>
                  </div>
                ))}
              </div>

              <!-- Active protocols -->
              <div class="card">
                <h3>Active protocols</h3>
                {activeProtocols.map((pr) => (
                  <div class="protocol">
                    <div>
                      <div class="pn">{escape(pr.name)}</div>
                      <div class="ps">{escape(pr.code)} · {pr.steps} steps</div>
                    </div>
                    <div class={`pst ${pr.overdue ? 'over' : 'ok'}`}>{pr.overdue ? `${pr.overdue} overdue` : 'On track'}</div>
                  </div>
                ))}
              </div>
            </div>
          ) : (
            <div class="kpis">
              {d.kpis.map((k) => (
                <div class="kpi">
                  <div class="n">{escape(k.n)}</div>
                  <div class="l">{escape(k.l)}</div>
                  {k.delta ? <div class={`delta ${k.dir || 'flat'}`}>{escape(k.delta)}</div> : null}
                </div>
              ))}
            </div>
          )}

          <div class="actions">
            {d.actions.map((a) => (
              <a class="btn btn-primary" href={ACTION_HREF[a] || `/app/dashboard/${persona}/`}>{escape(a)}</a>
            ))}
          </div>
        </div>
      </section>
    </div>

    <script is:inline define:vars={{ personaObj: p }}>
      // Restore session from the URL/known persona if localStorage is empty/cleared,
      // so a click into any screen page never dead-ends on a login bounce.
      (function () {
        try {
          var KEY = 'atunse_demo_session';
          var cur = null;
          try { cur = JSON.parse(localStorage.getItem(KEY)); } catch (e) {}
          if (!cur || !cur.id) {
            var pj = personaObj;
            if (pj) localStorage.setItem(KEY, JSON.stringify({ id: pj.id, name: pj.name, role: pj.role, username: pj.username, initials: pj.initials, accent: pj.accent, at: Date.now() }));
          }
        } catch (e) {}
      })();
    </script>
  </body>
</html>

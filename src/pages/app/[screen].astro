---
import { screens } from '../../data/screens.mjs';
import { PERSONAS } from '../../data/personas.mjs';
import '../../styles/global.css';

export function getStaticPaths() {
  return screens
    .filter((s) => s.html && !s.asset)
    .map((s) => ({ params: { screen: s.id } }));
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <title>Atunse Health</title>
  </head>
  <body>
    <div id="root" class="loading">Loading…</div>

    <script is:inline src="/demo-data.js"></script>
    <script is:inline>
      (function () {
        var KEY = 'atunse_demo_session';
        var DATA = window.__ATUNSE__;
        if (!DATA) { document.getElementById('root').textContent = 'Failed to load.'; return; }

        function getSession() {
          try { return JSON.parse(localStorage.getItem(KEY)); } catch (e) { return null; }
        }
        function canView(p, group) {
          if (!p) return false;
          if (p.deny && p.deny.indexOf(group) !== -1) return false;
          return p.allow.indexOf(group) !== -1;
        }
        function personaById(id) {
          for (var i = 0; i < DATA.personas.length; i++) if (DATA.personas[i].id === id) return DATA.personas[i];
          return null;
        }

        var session = getSession();
        if (!session) { window.location.replace('/'); return; }
        var persona = personaById(session.id) || session;

        var parts = location.pathname.split('/app/');
        var activeId = (parts[1] || '').replace(/\/$/, '');
        var active = null;
        for (var i = 0; i < DATA.screens.length; i++) if (DATA.screens[i].id === activeId) active = DATA.screens[i];
        if (active && !canView(persona, active.group)) { window.location.replace('/app/' + persona.landing + '/'); return; }

        // Spec left-nav order.
        var navOrder = ['Overview','Patients','Appointments','Clinical','Protocols','Billing','People','Institutions','Trust & Governance','Ogami','Reports','Administration','Mobile','AI Assistant','Assets & Docs','Scheduling','Compliance & Ledgers','Operations & Intelligence','Dashboards'];
        var visible = DATA.screens.filter(function (s) { return s.html && canView(persona, s.group); });
        var groups = {};
        visible.forEach(function (s) { (groups[s.group] = groups[s.group] || []).push(s); });
        var labelMap = { 'Dashboards':'Overview','Patient':'Patients','Clinical':'Clinical','Protocols':'Protocols','Billing & Finance':'Billing','Administration':'Administration','Scheduling':'Appointments','Compliance & Ledgers':'Trust & Governance','Operations & Intelligence':'Reports','Mobile':'Mobile','AI Assistant':'Ogami' };
        // Auth (the raw Stitch login screen) is not a menu item — session exit is the Log out button.
        delete groups['Auth'];
        var ordered = Object.keys(groups).sort(function (a, b) {
          var la = navOrder.indexOf(labelMap[a] || a), lb = navOrder.indexOf(labelMap[b] || b);
          return (la === -1 ? 99 : la) - (lb === -1 ? 99 : lb);
        });

        var navHtml = ordered.map(function (g) {
          var items = groups[g].map(function (s) {
            var cls = s.id === activeId ? 'nav-link active' : 'nav-link';
            return '<a class="' + cls + '" href="/app/' + s.id + '/" title="' + s.title + '">' + s.title + '</a>';
          }).join('');
          return '<div class="nav-group">' + (labelMap[g] || g) + '</div>' + items;
        }).join('');

        var crumb = active ? active.title : 'Dashboard';
        var isMobile = active && active.deviceType === 'MOBILE';
        var frameSrc = active ? active.html : '/stitch-screens/' + persona.landing + '.html';

        var root = document.getElementById('root');
        root.className = '';
        root.innerHTML =
          '<div class="app-shell">' +
            '<aside class="sidenav">' +
              '<div class="nav-head">' +
                '<img src="/assets/atunse-logo.png" alt="Atunse Health" class="logo" />' +
                '<span class="brand">Atunse Health</span>' +
              '</div>' +
              '<div class="who">' + persona.name + ' · <b>' + persona.role + '</b></div>' +
              '<nav class="nav">' + navHtml + '</nav>' +
              '<div class="nav-foot">' +
                '<button class="btn-logout" id="logout">Log out</button>' +
              '</div>' +
            '</aside>' +
            '<section class="stage">' +
              '<header class="stage-bar">' +
                '<span class="crumb">' + crumb + (isMobile ? ' <span class="tag">MOBILE</span>' : '') + '</span>' +
              '</header>' +
              '<div class="frame-host"><iframe src="' + frameSrc + '" title="' + crumb + '"></iframe></div>' +
            '</section>' +
          '</div>';

        document.getElementById('logout').addEventListener('click', function () {
          localStorage.removeItem(KEY);
          window.location.replace('/');
        });
      })();
    </script>
  </body>
</html>

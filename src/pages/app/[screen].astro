---
import { screens } from '../../data/screens.mjs';
import '../../styles/global.css';

export function getStaticPaths() {
  return screens
    .filter((s) => s.html && !s.asset)
    .map((s) => ({ params: { screen: s.id } }));
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <title>Atunse Health — Demo</title>
  </head>
  <body>
    <div id="root" class="loading">Loading demo session…</div>

    <script>
      import { guard, logout } from '../../lib/auth.mjs';
      import { screens } from '../../data/screens.mjs';
      import { canView } from '../../data/personas.mjs';

      const session = guard();
      const activeId = location.pathname.split('/app/')[1]?.replace(/\/$/, '') || '';

      // Role-based deep-link guard: block groups this persona may not see.
      const active = screens.find((s) => s.id === activeId);
      if (active && !canView(session, active.group)) {
        location.replace('/app/' + session.landing + '/');
      }

      const groupOrder = [
        'Auth', 'Dashboards', 'Patient', 'Clinical', 'Protocols', 'Compliance & Ledgers',
        'Scheduling', 'Billing & Finance', 'Administration', 'Operations & Intelligence',
        'Mobile', 'AI Assistant', 'Assets & Docs',
      ];
      const visible = screens.filter((s) => s.html && !s.asset && canView(session, s.group));
      const groups = {};
      for (const s of visible) (groups[s.group] = groups[s.group] || []).push(s);
      const orderedGroups = Object.keys(groups).sort((a, b) => groupOrder.indexOf(a) - groupOrder.indexOf(b));

      const navHtml = orderedGroups.map((g) => {
        const items = groups[g].map((s) => {
          const cls = s.id === activeId ? 'nav-link active' : 'nav-link';
          return `<a class="${cls}" href="/app/${s.id}/" data-id="${s.id}">${s.title}</a>`;
        }).join('');
        return `<div class="nav-group">${g}</div>${items}`;
      }).join('');

      const crumb = active ? active.title : 'Dashboard';
      const isMobile = active && active.deviceType === 'MOBILE';

      document.getElementById('root').className = '';
      document.getElementById('root').innerHTML = `
        <div class="app-shell">
          <header class="topbar">
            <div class="tb-left">
              <img src="/assets/atunse-logo.png" alt="Atunse Health" class="logo" />
              <span class="brand">Atunse Health</span>
              <span class="crumb">${crumb}${isMobile ? ' <span class="tag">MOBILE</span>' : ''}</span>
            </div>
            <div class="tb-right">
              <span class="who">${session.name} · <b>${session.role}</b></span>
              <button class="btn-logout" id="logout">Log out</button>
            </div>
          </header>
          <div class="body">
            <button class="nav-toggle" id="navtoggle" aria-label="Menu">☰</button>
            <aside class="sidenav" id="sidenav">
              <div class="login-as">
                <span class="av">${session.initials}</span>
                <div><div class="nm">${session.name}</div><div class="rl">${session.role}</div></div>
              </div>
              <nav class="nav">${navHtml}</nav>
            </aside>
            <section class="stage">
              <div class="frame-host">
                <iframe src="${active ? active.html : '/stitch-screens/' + session.landing + '.html'}" title="${crumb}"></iframe>
              </div>
            </section>
          </div>
        </div>
      `;

      document.getElementById('logout').addEventListener('click', () => { logout(); location.replace('/'); });
      const tog = document.getElementById('navtoggle');
      const nav = document.getElementById('sidenav');
      tog.addEventListener('click', () => nav.classList.toggle('open'));
    </script>
  </body>
</html>
